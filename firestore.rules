rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }
    function isRoomMember(roomId) {
      let room = get(/databases/$(database)/documents/rooms/$(roomId)).data;
      return signedIn() &&
        (request.auth.token.email.lower() == room.ownerEmail ||
         request.auth.token.email.lower() == room.partnerEmail);
    }

    match /rooms/{roomId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['ownerEmail','partnerEmail','salt','createdAt','protocol'])
        && request.resource.data.ownerEmail == request.auth.token.email.lower()
        && request.resource.data.partnerEmail is string
        && request.resource.data.partnerEmail != request.auth.token.email.lower()
        && request.resource.data.salt is string
        && request.resource.data.salt.size() <= 100;
      allow get: if signedIn() &&
        (request.auth.token.email.lower() == resource.data.ownerEmail ||
         request.auth.token.email.lower() == resource.data.partnerEmail);
      allow list: if false;
      allow update, delete: if false;

      match /messages/{messageId} {
        allow get, list: if isRoomMember(roomId);
        allow create: if isRoomMember(roomId)
          && request.resource.data.keys().hasOnly([
            'ciphertext','iv','senderUid','senderEmail','recipientEmail','createdAt'
          ])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.senderEmail == request.auth.token.email.lower()
          && request.resource.data.recipientEmail is string
          && request.resource.data.recipientEmail != request.auth.token.email.lower()
          && request.resource.data.ciphertext is string
          && request.resource.data.ciphertext.size() <= 12000
          && request.resource.data.iv is string;
        allow delete: if isRoomMember(roomId) &&
          (resource.data.senderUid == request.auth.uid ||
           resource.data.recipientEmail == request.auth.token.email.lower());
        allow update: if false;
      }
    }
  }
}